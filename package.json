{
  "name": "webblox",
  "private": true,
  "type": "module",
  "description": "Roblox's official browser client (WebClientApp), self-hosted",
  "scripts": {
    "start": "bun server.ts",
    "fetch:webblox": "node scripts/fetch-webblox.mjs",
    "build:proxy": "bun build integrations/scramjet/plugin.ts --target browser --format esm --outfile proxy/launch-plugin.mjs && bun run scripts/copy-scramjet-assets.mjs && bun run scripts/precompress.mjs",
    "build:swbn": "bun swbn/build-swbn.mjs",
    "test": "bun test",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@mercuryworkshop/epoxy-transport": "3.0.1",
    "@mercuryworkshop/scramjet": "2.0.67-alpha.2",
    "@mercuryworkshop/scramjet-controller": "0.0.14",
    "@mercuryworkshop/wisp-js": "0.5.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "typescript": "^5.9.3",
    "wbn": "^0.0.10",
    "wbn-sign": "^0.3.3"
  }
}
